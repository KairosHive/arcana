# Python/IDE related
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
.venv-pack/
.venv-pack-gpu/
*.env
*.sqlite3

# VSCode
.vscode/

# Dash/Flask stuff
*.log

# Ignore everything in images/, but keep the folder itself (images/ is at project root)
images/*
!images/.gitkeep

# Ignore all data output inside arcana/
arcana/databases/
arcana/latents/
arcana/output/
# Portable dataset bundles (generated; can be large)
arcana/bundles/
arcana/cache_specs/
arcana/cache/
# Scratch output from experiments run inside the package folder. Not
# arcana/*.png: arcana/assets/ holds the logo and icon, which are tracked.
arcana/test_output/
arcana/output_*.png

# Local media and third-party checkouts used for experiments. audio_dataset/
# and audio_library/ are ~1.5 GB of sound; NeuralPreset-main/ is someone
# else's repository, unpacked for reference.
audio_dataset/
audio_library/
NeuralPreset-main/

# If you have big assets
*.h5
*.ckpt
*.pt
*.pth

# The folder of videos tests/sandbox_app.py indexes on this machine.
tests/.sandbox_videos

# Python packaging artifacts
*.egg-info/

# Mac OS / Windows noise
.DS_Store
Thumbs.db

# ModFlows colour-transfer source + its 240 MB checkpoint.
#
# NOT a decision that this stays out of the repo -- it is untracked upstream too,
# and a packaged build WILL ship a broken colour-transfer feature until this is
# resolved (vendor it via git-lfs, or fetch it at build time from a recorded URL).
# Ignored here only so a junction/symlink used for local testing cannot be
# committed by accident. See docs/hardening-audit.md.
modflows/

# setuptools / uv build artefacts
build/
# PyInstaller's workpath for the GPU variant. This was missed when the GPU build
# was added -- `build/` alone does not match it -- and 211 MB of scratch went
# into a commit before anyone noticed.
build-gpu/
dist/

# Compiled installers. Arcana-Setup-*.exe is ~226 MB; build artefacts belong in
# a release, not in git history.
installer/out/
# Generated by arcana.spec at build time from arcana/__init__.py.
installer/version.iss
installer/file_version_info.txt

# Per-user Claude Code permissions; launch.json is shared.
.claude/settings.local.json
# The Agent tab's workspace (workspace.py), beside arcana/output in a checkout.
arcana/workspace/

# The Svelte page, built from frontend/ (npm run build). Rebuilt by the installer spec.
arcana/web/
frontend/node_modules/

# Python/IDE related
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv
.venv-pack/
*.env
*.sqlite3

# VSCode
.vscode/

# Dash/Flask stuff
*.log

# Ignore everything in images/, but keep the folder itself (images/ is at project root)
images/*
!images/.gitkeep

# Ignore all data output inside arcana/
arcana/databases/
arcana/latents/
arcana/output/
# Portable dataset bundles (generated; can be large)
arcana/bundles/
arcana/cache_specs/
arcana/cache/

# If you have big assets
*.h5
*.ckpt
*.pt
*.pth

# Python packaging artifacts
*.egg-info/

# Mac OS / Windows noise
.DS_Store
Thumbs.db

# ModFlows colour-transfer source + its 240 MB checkpoint.
#
# NOT a decision that this stays out of the repo -- it is untracked upstream too,
# and a packaged build WILL ship a broken colour-transfer feature until this is
# resolved (vendor it via git-lfs, or fetch it at build time from a recorded URL).
# Ignored here only so a junction/symlink used for local testing cannot be
# committed by accident. See docs/hardening-audit.md.
modflows/

# setuptools / uv build artefacts
build/
dist/

# Compiled installers. Arcana-Setup-*.exe is ~226 MB; build artefacts belong in
# a release, not in git history.
installer/out/
